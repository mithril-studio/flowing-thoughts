{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowingThoughts",
  "version": "0.4.0",
  "identifier": "com.flowingthoughts.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowingThoughts",
        "width": 460,
        "height": 640,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "visible": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' https://api.groq.com https://api.openai.com https://github.com https://*.githubusercontent.com ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNkQyMUY0RTMwMDhGMDUKUldRRmp3RGo5Q0Z0RXdic01nWW1WMVQ5K3k3UmpieXpYVFVtS05RRld2UEZRU3ZzamtidWlEY2sK",
      "endpoints": [
        "https://github.com/mithril-studio/flowing-thoughts-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
